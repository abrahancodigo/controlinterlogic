rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions for role checks (read from Firestore users collection)
    function hasRole(roles) {
      let user = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return (!('active' in user) || user.active != false) && (('role' in user) ? user.role.lower() : 'user') in roles;
    }

    function isAuthenticated() {
      return request.auth != null && hasRole(['user', 'editor', 'admin']);
    }

    function isAdmin() {
      return request.auth != null && hasRole(['admin']);
    }

    function canWrite() {
      return request.auth != null && hasRole(['editor', 'admin']);
    }
    // Reglas para entregas (existentes)
    match /deliveries/{imageId} {
      allow read: if isAuthenticated();
      allow delete: if isAdmin();
      allow create, update: if canWrite()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }


    // Reglas para asistencia
    // Solo imagenes (con null permitido por HEIC/iOS, mismo criterio que problemas)
    match /asistencia/{allPaths=**} {
      allow read: if isAuthenticated();
      allow delete: if isAdmin();
      allow create, update: if canWrite()
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType == null || request.resource.contentType.matches('image/.*'));
    }

    // Reglas para problemas
    // Nota: Aceptamos contentType null porque algunos navegadores/moviles
    // (especialmente iOS con HEIC) no envian el MIME type, aunque el
    // codigo JS fuerza un contentType via metadata en el upload.
    match /problemas/{allPaths=**} {
      allow read: if isAuthenticated();
      allow delete: if isAdmin();
      allow create, update: if canWrite()
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType == null || request.resource.contentType.matches('image/.*'));
    }

    // Reglas para fotos de vehículos
    // Solo imagenes (con null permitido por HEIC/iOS, mismo criterio que problemas)
    match /vehiculos/{allPaths=**} {
      allow read: if isAuthenticated();
      allow delete: if isAdmin();
      allow create, update: if canWrite()
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType == null || request.resource.contentType.matches('image/.*'));
    }
  }
}
